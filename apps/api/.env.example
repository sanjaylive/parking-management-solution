NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://park2all:park2all@127.0.0.1:57432/park2all?schema=public
REDIS_URL=redis://127.0.0.1:57379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
QR_SIGNING_SECRET=change-me-qr-signing-secret-min-32-chars
DEVICE_SECRET_ENCRYPTION_KEY=change-me-32-byte-hex-or-base64-key-here
# OTP delivery: "console" logs OTP in dev only (refused in production). Real SMS provider adapters pending credentials.
OTP_PROVIDER=console
# Payment provider: "sandbox" is an in-repo simulator signing webhooks with PAYMENT_WEBHOOK_SECRET. Razorpay adapter pending credentials.
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
CORS_ORIGINS=http://localhost:3101,http://localhost:3102,http://localhost:3103,http://localhost:3104,http://localhost:3105
