}

model ParkingPassVehicle {
  passId    String      @db.Uuid
  vehicleId String      @db.Uuid
  addedAt   DateTime    @default(now()) @db.Timestamptz(3)
  pass      ParkingPass @relation(fields: [passId], references: [id], onDelete: Cascade)
  vehicle   Vehicle     @relation(fields: [vehicleId], references: [id])

  @@id([passId, vehicleId])
}

model ParkingPassUsage {
  id         String      @id @default(uuid()) @db.Uuid
  passId     String      @db.Uuid
  sessionId  String      @db.Uuid
  facilityId String      @db.Uuid
  enteredAt  DateTime    @db.Timestamptz(3)
  exitedAt   DateTime?   @db.Timestamptz(3)
  pass       ParkingPass @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@index([passId, enteredAt])
}

// ───────────────────────────── Valet ─────────────────────────────

model ValetRequest {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @db.Uuid
  facilityId           String                  @db.Uuid
  sessionId            String                  @db.Uuid
  status               ValetStatus             @default(REQUESTED)
  keyTag               String?
  parkedLocation       String?
  requestedAt          DateTime                @default(now()) @db.Timestamptz(3)
  retrievalRequestedAt DateTime?               @db.Timestamptz(3)
  deliveredAt          DateTime?               @db.Timestamptz(3)
  customerConfirmedAt  DateTime?               @db.Timestamptz(3)
  session              ParkingSession          @relation(fields: [sessionId], references: [id])
  assignments          ValetAssignment[]
  handovers            VehicleHandover[]
  keyRecords           KeyCustodyRecord[]
  photos               VehicleConditionPhoto[]

  @@index([tenantId, facilityId, status])
}

model ValetAssignment {
  id          String       @id @default(uuid()) @db.Uuid
  requestId   String       @db.Uuid
  driverId    String       @db.Uuid
  task        String // PARK, RETRIEVE
  assignedAt  DateTime     @default(now()) @db.Timestamptz(3)
  completedAt DateTime?    @db.Timestamptz(3)
  request     ValetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model VehicleHandover {
  id        String       @id @default(uuid()) @db.Uuid
  requestId String       @db.Uuid
  direction String // CUSTOMER_TO_VALET, VALET_TO_CUSTOMER
  staffId   String       @db.Uuid
  odometer  Int?
  fuelLevel String?
  notes     String?
  at        DateTime     @default(now()) @db.Timestamptz(3)
  request   ValetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model KeyCustodyRecord {
  id        String       @id @default(uuid()) @db.Uuid
  requestId String       @db.Uuid
  holderId  String       @db.Uuid
  location  String // KEY_BOX_A12, DRIVER, CUSTOMER
  at        DateTime     @default(now()) @db.Timestamptz(3)
  request   ValetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model VehicleConditionPhoto {
  id         String       @id @default(uuid()) @db.Uuid
  requestId  String       @db.Uuid
  storageKey String
  angle      String
  takenById  String       @db.Uuid
  at         DateTime     @default(now()) @db.Timestamptz(3)
  request    ValetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Corporate ─────────────────────────────

model CorporateAccount {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @db.Uuid
  name         String
  gstin        String?
  billingEmail String
  status       String                @default("ACTIVE")
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members      CorporateMember[]
  contracts    CorporateContract[]
  allocations  CorporateAllocation[]
  invoices     CorporateInvoice[]

  @@index([tenantId])
}

model CorporateMember {
  id            String           @id @default(uuid()) @db.Uuid
  corporateId   String           @db.Uuid
  userId        String?          @db.Uuid
  name          String
  employeeCode  String?
  department    String?
  email         String?
  phone         String?
  isAdmin       Boolean          @default(false)
  active        Boolean          @default(true)
  vehiclePlates String[]
  corporate     CorporateAccount @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  @@index([corporateId])
}

model CorporateContract {
  id                  String           @id @default(uuid()) @db.Uuid
  corporateId         String           @db.Uuid
  startsAt            DateTime         @db.Timestamptz(3)
  endsAt              DateTime         @db.Timestamptz(3)
  billing             String           @default("MONTHLY_POSTPAID")
  ratePerSessionMinor Int?
  monthlyFeeMinor     Int?
  maxConcurrent       Int
  corporate           CorporateAccount @relation(fields: [corporateId], references: [id], onDelete: Cascade)
}

model CorporateAllocation {
  id           String           @id @default(uuid()) @db.Uuid
  corporateId  String           @db.Uuid
  facilityId   String           @db.Uuid
  vehicleClass VehicleClass
  units        Int
  inUse        Int              @default(0)
  corporate    CorporateAccount @relation(fields: [corporateId], references: [id], onDelete: Cascade)

  @@unique([corporateId, facilityId, vehicleClass])
}

model CorporateInvoice {
  id          String           @id @default(uuid()) @db.Uuid
  corporateId String           @db.Uuid
  number      String           @unique
  periodStart DateTime         @db.Timestamptz(3)
  periodEnd   DateTime         @db.Timestamptz(3)
  amountMinor Int
  status      String           @default("OPEN")
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  corporate   CorporateAccount @relation(fields: [corporateId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Support & audit ─────────────────────────────

model SupportTicket {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String?      @db.Uuid
  userId     String       @db.Uuid
  subject    String
  body       String
  status     TicketStatus @default(OPEN)
  priority   String       @default("NORMAL")
  refType    String?
  refId      String?      @db.Uuid
  assigneeId String?      @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  user       User         @relation(fields: [userId], references: [id])

  @@index([tenantId, status])
}

model IncidentReport {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  facilityId   String           @db.Uuid
  reportedById String           @db.Uuid
  category     String // LOST_TICKET, BARRIER_FAILURE, DAMAGE, DISPUTE, EMERGENCY, OTHER
  severity     IncidentSeverity @default(LOW)
  description  String
  sessionId    String?          @db.Uuid
  photoKeys    String[]
  resolvedAt   DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  @@index([tenantId, facilityId, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  actorId    String?  @db.Uuid
  actorKind  String // USER, DEVICE, SYSTEM
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, at])
  @@index([entityType, entityId])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
