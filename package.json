{
  "name": "park2all",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:infra": "docker compose -f infrastructure/docker-compose.dev.yml up -d",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "deploy": "bash scripts/deploy.sh",
    "deploy:status": "gh run list --workflow deploy.yml --limit 5"
  }
}
