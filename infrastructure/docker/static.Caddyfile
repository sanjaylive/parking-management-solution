{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	@nocache path */ */index.html */flutter_service_worker.js */flutter_bootstrap.js */version.json
	header @nocache Cache-Control no-cache

	handle /staff/* {
		try_files {path} /staff/index.html
		file_server
	}
	handle /app/* {
		try_files {path} /app/index.html
		file_server
	}
	respond 404
}
