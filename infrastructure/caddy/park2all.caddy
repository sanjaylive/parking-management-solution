# BEGIN park2all (park.2all.co.in)
# Site block for the shared edge Caddy (pay2all stack). Keep identical to the copy in that repo's
# infra/deploy/Caddyfile; remote-release.sh re-applies it between the BEGIN/END markers on each deploy.
# Containers are reached over the pay2all_internal network, which the park2all stack joins.
#   /                booking website      /operator   operator console
#   /v1, /health, /socket.io   API        /staff/     staff app      /app/   customer app (Flutter web)
park.2all.co.in {
	encode zstd gzip
	request_body {
		max_size 5MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /v1/* /health /socket.io/*
	handle @api {
		reverse_proxy park-api:4100
	}

	handle /operator* {
		reverse_proxy park-operator:3101
	}

	redir /staff /staff/ 308
	redir /app /app/ 308
	@static path /staff/* /app/*
	handle @static {
		reverse_proxy park-static:8080
	}

	handle {
		reverse_proxy park-booking:3104
	}

	log {
		output stdout
		format json
	}
}
# END park2all
